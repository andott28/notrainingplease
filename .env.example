# NVIDIA API Configuration
NVIDIA_API_KEY=your_real_nvidia_api_key
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct

# Proxy Server Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=8923
UPSTREAM_TIMEOUT_S=120

# Protection and Masking Strategy
# PROTECTION_MODE: off, balanced (default), strict
PROTECTION_MODE=balanced

# Strict mode backend handling
# STRICT_BACKEND: reject (default) or local
# Set STRICT_LOCAL_URL to forward strictly-sensitive requests to a local model
STRICT_BACKEND=reject
STRICT_LOCAL_URL=
STRICT_LOCAL_TIMEOUT_S=30

# Masking strategy: token_substitution (default) or opaque
MASKING_STRATEGY=token_substitution

# Tokenizer model for token_substitution strategy
TOKEN_CIPHER_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct

# Semantic obfuscation: re-encode the prompt at the token level using a
# persisted random codebook, so the upstream model still sees a semantically
# equivalent sequence while the raw surface form is unreadable to humans.
# SEMANTIC_OBFUSCATION: true or false (default false)
# SEMANTIC_OBFUSCATION_LEVEL: light | standard | aggressive (default standard)
# SEMANTIC_OBFUSCATION_ANCHOR_MODEL: model id whose embedding matrix is used
#   to build the codebook. Defaults to TOKEN_CIPHER_MODEL_ID.
# SEMANTIC_OBFUSCATION_CODEBOOK_PATH: where the codebook is cached on disk
# SEMANTIC_OBFUSCATION_INCLUDE_SYSTEM: also obfuscate system messages (off by
#   default, because the masking system note needs to stay readable)
# SEMANTIC_OBFUSCATION_LOAD_ANCHOR_BODY: load the full model body for the
#   strongest embedding-based codebook (true, default) or skip and use a
#   smaller fallback encoder (false, lower fidelity)
# SEMANTIC_OBFUSCATION_DECODE_RESPONSE: also reverse the encoding on the
#   model's response. Off by default because it can cause false-positive
#   substitutions on common English tokens. Enable only if you accept the
#   tradeoff and need a fully round-tripped reply.
SEMANTIC_OBFUSCATION=false
SEMANTIC_OBFUSCATION_LEVEL=standard
SEMANTIC_OBFUSCATION_ANCHOR_MODEL=
SEMANTIC_OBFUSCATION_CODEBOOK_PATH=.agent/semantic_codebook.json
SEMANTIC_OBFUSCATION_INCLUDE_SYSTEM=false
SEMANTIC_OBFUSCATION_LOAD_ANCHOR_BODY=true
SEMANTIC_OBFUSCATION_DECODE_RESPONSE=false

# Session vault: maintains masking consistency across requests
SESSION_VAULT_ENABLED=true
SESSION_VAULT_TTL_S=86400
SESSION_VAULT_MAX_SESSIONS=1000

# Local API key (generated by GUI, optional for CLI usage)
# LOCAL_API_KEY=sk-local-xxxx
